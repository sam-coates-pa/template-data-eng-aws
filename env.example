###############################################################################
# ENVIRONMENT VARIABLE TEMPLATE (AWS)
#
# This file provides placeholders for ALL environment variables required by the
# AWS Data Engineering Template repository.
#
# HOW TO USE THIS FILE:
#
# 1. DUPLICATE this file:
#        cp env.example .env
#
# 2. OPEN `.env` and fill in your REAL values.
#
# 3. DO NOT commit `.env` to Git — it contains secrets.
#    It should already be listed in `.gitignore`.
#
# 4. Your Python applications (Glue triggers, Lambda invokers, Redshift loaders,
#    S3 uploaders, Prefect flows) will automatically load `.env` if using 
#    python-dotenv.
#
# 5. All values in this file are placeholders — NO real secrets are included.
###############################################################################


##############################################
# AWS Credentials
##############################################
# Required ONLY if NOT running on an IAM Role-enabled environment
# such as EC2, ECS, Lambda, or SageMaker.
#
# If running locally, these provide boto3 credentials.
#
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-2


##############################################
# Optional: Session Token
##############################################
# Used for temporary AWS credentials issued by STS or SSO.
#
# Example (only for short-lived sessions):
# AWS_SESSION_TOKEN=XYZ123
AWS_SESSION_TOKEN=


##############################################
# S3 Configuration
##############################################
# S3 bucket and prefix used for storing raw and processed data.
#
# Example:
# S3_BUCKET_NAME=my-data-bucket-dev
# S3_PREFIX=raw/events/
#
S3_BUCKET_NAME=
S3_PREFIX=


##############################################
# Glue Job Configuration
##############################################
# Name of AWS Glue job to trigger.
# Temporary directory for Glue ETL job (often on S3).
#
# Example:
# GLUE_JOB_NAME=my-etl-job
# GLUE_TEMP_DIR=s3://my-bucket/temp/
#
GLUE_JOB_NAME=
GLUE_TEMP_DIR=


##############################################
# Lambda Configuration
##############################################
# Name of a Lambda function your pipeline will invoke.
#
# Example:
# LAMBDA_FUNCTION_NAME=my-transform-lambda
#
LAMBDA_FUNCTION_NAME=


##############################################
# Redshift Configuration
##############################################
# Used for data loading / COPY commands into Redshift.
#
# REDSHIFT_CLUSTER_ID:
#   The name of the Redshift cluster (not the endpoint)
#
# REDSHIFT_DATABASE:
#   The database name inside Redshift
#
# REDSHIFT_DB_USER:
#   Username with query + copy privileges
#
# REDSHIFT_IAM_ROLE_ARN:
#   IAM Role with AmazonS3ReadOnlyAccess and Redshift COPY permissions
#
# Example:
# REDSHIFT_CLUSTER_ID=my-redshift-dev
# REDSHIFT_DATABASE=analytics
# REDSHIFT_DB_USER=etl_user
# REDSHIFT_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/RedshiftCopyRole
#
REDSHIFT_CLUSTER_ID=
REDSHIFT_DATABASE=
REDSHIFT_DB_USER=
REDSHIFT_IAM_ROLE_ARN=


##############################################
# Prefect (Optional)
##############################################
# Only needed if running Prefect Cloud or Prefect Server.
#
# PREFECT_API_URL:
#   URL of your Prefect workspace or self-hosted Prefect server.
#
# PREFECT_API_KEY:
#   API key for authentication.
#
# Leave these blank if running flows locally without Prefect Cloud.
#
PREFECT_API_URL=
PREFECT_API_KEY=


###############################################################################
# END OF FILE
#
# Reminder:
#  - Keep env.example in version control.
#  - DO NOT commit .env or real secrets.
#  - Secrets should be managed using AWS Secrets Manager or environment vars.
###############################################################################
